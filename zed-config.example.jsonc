// Zed configuration example — add these lines to ~/.config/zed/settings.json.
//
// The "intellij-server" language server is provided by the extension.
// Install it first:
//   1. Run ./scripts/install.sh to download the LSP server
//   2. Copy extension.wasm + extension.toml to Zed's extensions folder:
//      mkdir -p ~/Library/Application\ Support/Zed/extensions/installed/intellij-lsp-zed/
//      cp extension.wasm extension.toml ~/Library/Application\ Support/Zed/extensions/installed/intellij-lsp-zed/
//
// Restart Zed (Cmd+Shift+P → zed: reload) after any changes.

{
  "languages": {
    "Java": {
      "language_servers": ["intellij-server", "!jdtls"],
    },
    "Kotlin": {
      "language_servers": ["intellij-server", "!kotlin-language-server"],
    },
  },
}
